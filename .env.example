# ==============================================================================
# Modèle des variables d'environnement frontend (Vite)
# ==============================================================================
# Fichiers par environnement :
#   - `.env.development` : valeurs utilisées lors de `npm run dev`
#   - `.env.production`  : valeurs utilisées lors de `npm run build`
#   - `.env.local`        : surcharges locales ignorées par Git
# ==============================================================================

# URL racine du backend (sans préfixe /api)
VITE_API_URL=http://localhost:8000
