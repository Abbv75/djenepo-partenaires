# ==============================================================================
# Modèle des variables d'environnement frontend (Vite)
# ==============================================================================
# Fichiers par environnement :
#   - `.env.development` : vide en dev pour passer par le proxy Vite
#   - `.env.production`  : https://djenepo-partners.com/backend/public
#   - `.env.local`        : surcharges locales éventuelles
# ==============================================================================

# Laisser vide en local si utilisation du proxy Vite, ou spécifier l'URL distante
VITE_API_URL=
